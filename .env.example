# This file lists the environment variables the app reads. Copy it to .env
# and fill in REAL values locally. Never commit the real .env file.
#
# Required — the Express API server refuses to start without these.
SESSION_SECRET=replace_with_a_random_string_of_at_least_16_characters
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional — used only if the app provides no value otherwise.
# Credentials for the auto-created default admin account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_admin_password

# Port the API server listens on (API_PORT is used before PORT).
API_PORT=3000
PORT=3000

# Vite base path (default "/", only change when hosting under a sub-path).
BASE_PATH=/

# Pino log level (default "info": trace|debug|info|warn|error|fatal).
LOG_LEVEL=info

# Host usually sets this (development | production | test).
NODE_ENV=development